function [public_vars] = student_workspace(read_only_vars,public_vars)
%STUDENT_WORKSPACE Summary of this function goes here

% 8. Perform initialization procedure
if (read_only_vars.counter == 1)
    public_vars.pf_enabled       = 0;
    public_vars.motion_vector    = [0, 0];
    public_vars.gnss_log         = [];
    public_vars.gnss_prev        = false;

    public_vars = init_kalman_filter(read_only_vars, public_vars);

    z0 = read_only_vars.gnss_position;
    if isnan(z0(1))
        % Start v GNSS-denied zone - ihned spust PF
        public_vars = init_particle_filter(read_only_vars, public_vars);
        public_vars.pf_enabled    = 1;
        public_vars.gnss_init_done = true;
    end

    public_vars.path       = [];
    public_vars.prev_pose  = [nan, nan, nan];
    public_vars.spin_count = 0;
end

% Zjisti aktualni dostupnost GNSS
z = read_only_vars.gnss_position;
public_vars.gnss_available = ~isnan(z(1));

% Task 1 - inicializacni faze: sbir GNSS mereni (pouze pokud zacali jsme s GNSS)
N_init = 100;
if ~public_vars.gnss_init_done
    if public_vars.gnss_available
        public_vars.gnss_log = [public_vars.gnss_log; z];
    end

    if size(public_vars.gnss_log, 1) >= N_init
        gnss_mean = mean(public_vars.gnss_log);
        gnss_cov  = cov(public_vars.gnss_log);

        public_vars.kf.Q = gnss_cov;

        public_vars.mu    = [gnss_mean(1); gnss_mean(2); pi/2];
        public_vars.sigma = [gnss_cov, zeros(2,1); zeros(1,2), pi^2];

        public_vars.gnss_init_done = true;
    else
        % Robot stoji a ceka na dostatek GNSS dat
        public_vars.motion_vector = [0, 0];
        public_vars.gnss_prev = public_vars.gnss_available;
        return;
    end
end

% Detekce prechodu GNSS dostupne -> nedostupne (vjezd do indoor zony)
entering_indoor = public_vars.gnss_prev && ~public_vars.gnss_available;
if entering_indoor
    % Inicializuj particles okolo aktualniho EKF odhadu
    N = read_only_vars.max_particles;
    std_xy    = 0.2;
    std_theta = 0.15;
    mu = public_vars.mu;
    public_vars.particles = [mu(1) + std_xy * randn(N, 1), mu(2) + std_xy * randn(N, 1), mu(3) + std_theta * randn(N, 1)];
    public_vars.pf_enabled = 1;
end

% Detekce navratu do GNSS zone
if ~public_vars.gnss_prev && public_vars.gnss_available
    public_vars.pf_enabled = 0;
end

public_vars.gnss_prev = public_vars.gnss_available;

% 9. Update particle filter - pouze v indoor zone (bez GNSS)
if public_vars.pf_enabled
    public_vars.particles = update_particle_filter(read_only_vars, public_vars);

    % Kontrola konvergence PF - pokud particles jeste nekonvergovaly, stoj
    pf_std = mean(std(public_vars.particles(:,1:2)));
    if pf_std > 1.0
        public_vars.motion_vector = [0, 0];
        return;
    end
end

% 10. Update Kalman filter
[public_vars.mu, public_vars.sigma] = update_kalman_filter(read_only_vars, public_vars);

% 11. Estimate current robot position
public_vars.estimated_pose = estimate_pose(public_vars); % (x,y,theta)

% Detekce PF lokalizace mimo mapu - reset PF
if public_vars.pf_enabled
    lim = read_only_vars.map.limits;
    ex  = public_vars.estimated_pose(1);
    ey  = public_vars.estimated_pose(2);
    if ex < lim(1) || ex > lim(3) || ey < lim(2) || ey > lim(4)
        public_vars = init_particle_filter(read_only_vars, public_vars);
    end
end

% Detekce skokove zmeny polohy - preplanovani trasy
replan_threshold = 1.0; % metry
if ~any(isnan(public_vars.prev_pose))
    pose_jump = norm(public_vars.estimated_pose(1:2) - public_vars.prev_pose(1:2));
    if pose_jump > replan_threshold
        public_vars.path = [];
    end

    % Detekce toceni/krouzeni - reinicializace PF
    if public_vars.pf_enabled
        delta_theta = abs(atan2(sin(public_vars.estimated_pose(3) - public_vars.prev_pose(3)), ...
                                cos(public_vars.estimated_pose(3) - public_vars.prev_pose(3))));
        if delta_theta > 0.08
            public_vars.spin_count = public_vars.spin_count + 1;
        else
            public_vars.spin_count = 0;
        end
        if public_vars.spin_count > 30
            public_vars = init_particle_filter(read_only_vars, public_vars);
            public_vars.spin_count = 0;
            disp('PF reinicializovan - detekce toceni');
        end
    end
end
public_vars.prev_pose = public_vars.estimated_pose;

% 12. Path planning
public_vars.path = plan_path(read_only_vars, public_vars);

% 13. Plan next motion command
public_vars = plan_motion(read_only_vars, public_vars);

% Collision check - LIDAR
collision_threshold = 0.2; % metry
lidar = read_only_vars.lidar_distances;
[min_dist, min_idx] = min(lidar);
if min_dist < collision_threshold
    % Uhel nejblizsi prekazky v globalnim souradnem systemu
    obstacle_angle = read_only_vars.lidar_config(min_idx) + public_vars.estimated_pose(3);
    % Relativni uhel prekazky vuci smeru robota
    rel_angle = atan2(sin(obstacle_angle - public_vars.estimated_pose(3)), ...
                      cos(obstacle_angle - public_vars.estimated_pose(3)));
    % Otoc se od prekazky
    if rel_angle > 0
        public_vars.motion_vector = [0, 0.1]; % otoc doleva
    else
        public_vars.motion_vector = [0.1, 0]; % otoc doprava
    end
end

end
