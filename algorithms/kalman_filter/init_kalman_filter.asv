function [public_vars] = init_kalman_filter(read_only_vars, public_vars)
%INIT_KALMAN_FILTER Initialize EKF/KF matrices and initial belief

% Observation matrix: GNSS measures x and y only
public_vars.kf.C = [1 0 0; 0 1 0];

% kovariance procesního šumu Rt
public_vars.kf.R = diag([0.005, 0.005, 0.05]); % x, y, theta

% Measurement noise covariance Q - placeholder, updated after GNSS init
public_vars.kf.Q = diag([0.1, 0.1]);

% Interwheel distance [m]
public_vars.kf.L = 0.2;

% Task 3: known initial pose with high certainty (zero covariance)
public_vars.mu    = [2; 2; pi/2];
public_vars.sigma = zeros(3, 3);

% Flag set to true once GNSS covariance has been computed
public_vars.gnss_init_done = false;

end
